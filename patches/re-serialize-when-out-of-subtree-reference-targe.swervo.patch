-
-        Some(defs_node)
+        defs_node
     }
 
     /// Inline elements referenced from this subtree via `url(#id)` in `mask`, `clip-path`,
@@ -215,7 +250,11 @@ impl SVGSVGElement {
     /// can't resolve those ids and drops the reference entirely (an unmasked rect renders as a
