@@ -147,10 +248,11 @@ fn decode_bytes_sync(
     let image = if is_svg_document {
         parse_svg_document_in_memory(bytes, fontdb)
             .ok()
-            .map(|(svg_tree, source)| {
+            .map(|(svg_tree, source, root_view_box)| {
                 DecodedImage::Vector(VectorImageData {
                     svg_tree: Arc::new(svg_tree),
