+                    // of the next, or inside a cluster of zero-width glyphs, are one stop.
+                    if stops.last().is_some_and(|last| last.x == stop.x) {
+                        continue;
+                    }
+                    stops.push(LaidOutCaretStop {
+                        node,
+                        offset,
+                        x: stop.x,
+                    });
+                }
+                (!stops.is_empty()).then_some(LaidOutCaretLine {
+                    top: line.top,
+                    bottom: line.bottom,
+                    stops,
+                })
