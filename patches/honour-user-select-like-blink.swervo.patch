+            .following_nodes_unrooted(no_gc, &ancestor, ShadowIncluding::No)
+            .filter_map(UnrootedDom::downcast::<Text>);
+
+        for child in iter {
+            if self.contains(child.upcast()) && include(child.upcast()) {
+                s.push_str(&child.upcast::<CharacterData>().Data().str());
