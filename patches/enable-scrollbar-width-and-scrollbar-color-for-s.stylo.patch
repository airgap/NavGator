From 16553b63d64345e93210b1ced18f3bd902f2896e Mon Sep 17 00:00:00 2001
From: Nicole Muzzin <nicks@fuckin.email>
Date: Sun, 4 Oct 2026 06:03:46 -0400
Subject: [PATCH] longhands: enable scrollbar-width and scrollbar-color for
 Servo

Both were Gecko-only, so Servo dropped `scrollbar-width: none` and `scrollbar-color`
declarations as unknown, and CSS.supports() reported them unsupported. Servo's overlay
scrollbars do not read either property yet, so a change only needs a repaint rather
than the default box rebuild.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 style/properties/longhands.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/style/properties/longhands.toml b/style/properties/longhands.toml
index 687d4c06e..7c0da82ea 100644
--- a/style/properties/longhands.toml
+++ b/style/properties/longhands.toml
@@ -1856,8 +1856,8 @@ affects = "paint"
 type = "ScrollbarColor"
 initial = "Default::default()"
 struct = "inherited_ui"
-engine = "gecko"
 spec = "https://drafts.csswg.org/css-scrollbars-1/#scrollbar-color"
+servo_restyle_damage = "repaint"
 boxed = true
 ignored_when_colors_disabled = true
 affects = "paint"
@@ -4128,8 +4128,8 @@ keyword = { values = ["auto", "normal", "active", "disabled", "inactive"] }
 
 [scrollbar-width]
 struct = "ui"
-engine = "gecko"
 spec = "https://drafts.csswg.org/css-scrollbars-1/#scrollbar-width"
+servo_restyle_damage = "repaint"
 animation_type = "discrete"
 affects = "layout"
 keyword = { values = ["auto", "thin", "none"] }
-- 
2.43.0

