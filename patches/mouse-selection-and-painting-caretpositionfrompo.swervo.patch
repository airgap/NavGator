+    let start = match &content[first] {
+        BlockContent::Text(text) => (text.clone(), 0),
+        BlockContent::LineBreak(node) | BlockContent::Block(node) => (
+            node.GetParentNode().expect("Content of a block has a parent"),
+            node.index(),
+        ),
+    };
