+                IntersectionObserverCallbackType::LazyLoad,
+                root,
+                margin(),
+                margin(),
+            )),
+            window,
+            None,
+            cx,
+        );
+        observer.thresholds.replace(vec![Finite::wrap(0.)]);
+        observer
+    }
