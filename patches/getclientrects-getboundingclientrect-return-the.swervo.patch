+    #[servo_tracing::instrument(skip_all)]
+    fn query_text_range_rects(
+        &self,
+        node: TrustedNodeAddress,
+        utf16_range: Range<usize>,
+    ) -> CSSPixelRectVec {
+        with_layout_state(|| {
