 .../script/dom/execcommand/basecommand.rs     |  2 +
 .../dom/execcommand/commands/inserttext.rs    | 99 +++++++++++++++++++
 .../script/dom/execcommand/commands/mod.rs    |  1 +
 .../script/dom/execcommand/execcommands.rs    | 69 +++++++++++++
 5 files changed, 201 insertions(+)
