 components/script/dom/element/element.rs      | 20 ++---------
 components/script/dom/node/node.rs            | 16 +++++----
 .../layout_dom/servo_dangerous_style_node.rs  | 31 +++++-----------
 4 files changed, 56 insertions(+), 47 deletions(-)

