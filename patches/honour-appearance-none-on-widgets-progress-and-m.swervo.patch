From f7c6252f1b5e1648b8f9c85167bd624fb2ff3e73 Mon Sep 17 00:00:00 2001
From: Nicole Muzzin <nicks@fuckin.email>
Date: Sun, 4 Oct 2026 03:13:20 -0400
Subject: [PATCH] layout: honour appearance:none on widgets; progress and meter
 fill; Chrome control defaults

appearance:none was ignored, so custom checkboxes and radios kept swervo's check glyph, ring,
border and 14px clamps, and custom selects showed the native arrow next to the page's own.
Widgets now declare -moz-default-appearance, and @appearance-base rules at the end of servo.css
undo the native look when appearance is none, as Chrome draws no native parts then: checkboxes
and radios keep only author styling (0x0 when unsized) and author ::before/::after no longer
inherit UA pseudo styles; the select arrow, now the ::-servo-select-arrow shadow part instead of
an inline-styled div, is hidden.

<progress> and <meter> never showed their fill because their UA rules used descendant selectors
from the host into its UA shadow tree. Their shadow parts are now the ::-webkit-progress-bar/
-value and ::-webkit-meter-bar/-*-value pseudo-elements (the meter value switches pseudo with the
optimum region, as in Chrome), sized and coloured like Chrome's native bars, with Chrome's
gray/green and gradient looks under appearance:none.

Form controls use Chrome's fixed 13.333px font size, and textareas use monospace like Chrome.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 components/layout/stylesheets/servo.css       | 166 +++++++++++++++---
 .../script/dom/html/htmlmeterelement.rs       |  36 +++-
 .../script/dom/html/htmlprogresselement.rs    |  29 ++-
 .../script/dom/html/htmlselectelement.rs      |  22 +--
 4 files changed, 204 insertions(+), 49 deletions(-)

diff --git a/components/layout/stylesheets/servo.css b/components/layout/stylesheets/servo.css
index 3fa740baf7a..e11679aff29 100644
--- a/components/layout/stylesheets/servo.css
+++ b/components/layout/stylesheets/servo.css
@@ -50,6 +50,11 @@ textarea {
   word-spacing: initial;
 }
 
+/* Chrome (and Firefox) set textareas in monospace. */
+textarea {
+  font-family: monospace;
+}
+
 input:disabled,
 textarea:disabled {
   cursor: unset;
@@ -271,6 +276,23 @@ select optgroup:disabled::before {
   color: rgb(128, 128, 128);
 }
 
+select {
+  -moz-default-appearance: menulist;
+}
+
+select::-servo-select-arrow {
+  background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="180" height="180" viewBox="0 0 180 180"> <path d="M10 50h160L90 130z" style="fill:currentcolor"/> </svg>');
+  background-size: 100%;
+  background-repeat: no-repeat;
+  background-position: center;
+
+  vertical-align: middle;
+  line-height: 1;
+  display: inline-block;
+  width: 0.75em;
+  height: 0.75em;
+}
+
 input[type="file"] {
   cursor: default;
   display: inline-block;
@@ -371,6 +393,7 @@ input[type="radio"] {
 }
 
 input[type="checkbox"] {
+  -moz-default-appearance: checkbox;
   border: 1px solid grey;
 }
 
@@ -428,6 +451,7 @@ input[type="checkbox"]:indeterminate::before {
 }
 
 input[type="radio"] {
+  -moz-default-appearance: radio;
   display: inline-block;
 
   /* TODO: According to https://wpt.fyi/results/css/css-grid/stretch-grid-item-radio-input.html,
@@ -591,28 +615,52 @@ details[open]::details-content {
   display: table;
 }
 
+/* <meter> and <progress> take Chrome's sizes, and their bars imitate its native look; the
+   @appearance-base rules at the end of this sheet hold the look Chrome gives them under
+   `appearance: none`. */
 meter {
+  appearance: auto;
+  -moz-default-appearance: meter;
+  box-sizing: border-box;
   display: inline-block;
-  width: 100px;
-  height: 12px;
-  border-radius: 6px;
-  background: linear-gradient(#e6e6e6, #e6e6e6, #eeeeee 20%, #cccccc 45%, #cccccc 55%);
-  overflow: clip;
+  block-size: 1em;
+  inline-size: 5em;
+  vertical-align: -0.2em;
 }
 
-/* FIXME: These should use the ::-moz-meter-bar pseudo element */
-meter div {
-  height: 100%;
+meter::-webkit-meter-bar,
+progress::-webkit-progress-bar {
+  display: block;
+  box-sizing: border-box;
+  position: relative;
+  inset-block-start: 25%;
+  block-size: 50%;
+  inline-size: 100%;
+  overflow: hidden;
+  background: #efefef;
+  border: 1px solid rgba(118, 118, 118, 0.3);
+  border-radius: 20px;
+}
+
+meter::-webkit-meter-optimum-value,
+meter::-webkit-meter-suboptimum-value,
+meter::-webkit-meter-even-less-good-value,
+progress::-webkit-progress-value {
+  display: block;
+  box-sizing: border-box;
+  block-size: 100%;
 }
 
-meter:-moz-meter-optimum div {
-  background: linear-gradient(#ad7, #ad7, #cea 20%, #7a3 45%, #7a3 55%);
+meter::-webkit-meter-optimum-value {
+  background: #107c10;
 }
-meter:-moz-meter-sub-optimum div {
-  background: linear-gradient(#fe7, #fe7, #ffc 20%, #db3 45%, #db3 55%);
+
+meter::-webkit-meter-suboptimum-value {
+  background: #ffb900;
 }
-meter:-moz-meter-sub-sub-optimum div {
-  background: linear-gradient(#f77, #f77, #fcc 20%, #d44 45%, #d44 55%);
+
+meter::-webkit-meter-even-less-good-value {
+  background: #d83b01;
 }
 
 /* https://html.spec.whatwg.org/#the-details-and-summary-elements */
@@ -628,21 +676,91 @@ details[open] > summary:first-of-type {
   list-style-type: disclosure-open;
 }
 
-/* Styles for the <progress> element */
 progress {
+  appearance: auto;
+  -moz-default-appearance: progress-bar;
+  box-sizing: border-box;
   display: inline-block;
-  width: 200px;
-  height: 6px;
-  border-radius: 3px;
-  border: 1px solid rgba(0, 0, 0, 0.5);
+  block-size: 1em;
+  inline-size: 10em;
+  vertical-align: -0.2em;
 }
-/* FIXME: This should use ::-moz-progress-bar */
-progress #-servo-progress-bar {
-  display: block;
-  height: 100%;
-  background-color: #7a3;
+
+progress::-webkit-progress-bar {
+  border-color: #b2b2b2;
+}
+
+progress::-webkit-progress-value {
+  background: #0075ff;
 }
 
 slot {
   display: contents;
 }
+
+/* What widgets look like under `appearance: none`: Chrome draws no native parts then, so the
+   widget shows only what CSS gives it. These rules repeat the selectors of the native-look
+   rules above so that they win over them. */
+@appearance-base {
+  input:is([type="checkbox"], [type="radio"]),
+  input:is([type="checkbox"], [type="radio"]):is(:checked, :disabled),
+  input:is([type="checkbox"], [type="radio"]):checked:disabled {
+    box-sizing: border-box;
+    width: auto;
+    height: auto;
+    min-width: auto;
+    min-height: auto;
+    max-width: none;
+    max-height: none;
+    padding: initial;
+    border: initial;
+    border-radius: initial;
+    background: initial;
+    overflow: initial;
+  }
+
+  input:is([type="checkbox"], [type="radio"])::before,
+  input:is([type="checkbox"], [type="radio"])::after,
+  input:is([type="checkbox"], [type="radio"]):is(:checked, :disabled, :indeterminate)::before,
+  input:is([type="checkbox"], [type="radio"]):is(:checked, :disabled, :indeterminate)::after,
+  input:is([type="checkbox"], [type="radio"]):checked:disabled::before,
+  input:is([type="checkbox"], [type="radio"]):checked:disabled::after {
+    all: unset;
+  }
+
+  select::-servo-select-arrow {
+    display: none;
+  }
+
+  progress::-webkit-progress-bar,
+  meter::-webkit-meter-bar {
+    border: initial;
+    border-radius: initial;
+  }
+
+  progress::-webkit-progress-bar {
+    inset-block-start: auto;
+    block-size: 100%;
+    background: gray;
+  }
+
+  progress::-webkit-progress-value {
+    background: green;
+  }
+
+  meter::-webkit-meter-bar {
+    background: linear-gradient(to bottom, #ddd, #eee 20%, #ccc 45%, #ccc 55%, #ddd);
+  }
+
+  meter::-webkit-meter-optimum-value {
+    background: linear-gradient(to bottom, #ad7, #cea 20%, #7a3 45%, #7a3 55%, #ad7);
+  }
+
+  meter::-webkit-meter-suboptimum-value {
+    background: linear-gradient(to bottom, #fe7, #ffc 20%, #db3 45%, #db3 55%, #fe7);
+  }
+
+  meter::-webkit-meter-even-less-good-value {
+    background: linear-gradient(to bottom, #f77, #fcc 20%, #d44 45%, #d44 55%, #f77);
+  }
+}
