+/// Intersect two sorted lists of disjoint `[start, end)` ranges.
+fn intersect_ranges(a: &[(f64, f64)], b: &[(f64, f64)]) -> Vec<(f64, f64)> {
+    let (mut i, mut j) = (0, 0);
+    let mut intersection = vec![];
