+    <div display="grid" direction="ltr" width="400px" grid-template-columns="100px 1fr">
+      <div direction="ltr" height="20px"/>
+      <div direction="ltr" width="500px" height="20px" max-width="250px" margin-top="0px" margin-left="auto" margin-bottom="0px" margin-right="auto"/>
+    </div>
+  </input>
+  <expectations>
+    <node x="0" y="0" width="400" height="20">
+      <node x="0" y="0" width="100" height="20"/>
+      <node x="125" y="0" width="250" height="20"/>
+    </node>
+  </expectations>
+</test>
