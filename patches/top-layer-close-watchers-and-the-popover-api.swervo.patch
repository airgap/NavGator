+    /// <https://html.spec.whatwg.org/multipage/#light-dismiss-open-popovers>
+    fn light_dismiss_open_popovers(
+        &self,
+        cx: &mut JSContext,
+        event_type: LightDismissEventType,
+        target: &Node,
+    ) {
