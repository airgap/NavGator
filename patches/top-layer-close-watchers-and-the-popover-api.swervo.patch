+        event: &MouseEvent,
+        event_type: LightDismissEventType,
+        target: &Node,
+    ) {
+        // > 3. If document's open dialogs list is empty, then return.
+        if self.open_dialogs_list.borrow().is_empty() {
+            return;
+        }
