diff --git a/components/layout/stylesheets/user-agent.css b/components/layout/stylesheets/user-agent.css
index f6de7335ae6..7bf2924fc96 100644
--- a/components/layout/stylesheets/user-agent.css
+++ b/components/layout/stylesheets/user-agent.css
@@ -111,6 +111,13 @@ dialog:modal, :popover-open {
   -servo-top-layer: top;
 }
 
+/* https://html.spec.whatwg.org/multipage/#inert-subtrees: hit testing skips inert nodes, so
+   clicks reach whatever is beneath them, as in Chrome. A modal dialog escapes the inertness of
+   its ancestors. */
+[inert], [inert] :not(dialog:modal, [inert] dialog:modal *) {
+  pointer-events: none !important;
+}
+
