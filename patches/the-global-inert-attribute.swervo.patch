+    make_bool_getter!(Inert, "inert");
+    // https://html.spec.whatwg.org/multipage/#dom-inert
+    make_bool_setter!(cx, SetInert, "inert");
+
     // https://html.spec.whatwg.org/multipage/#globaleventhandlers
     global_event_handlers!(NoOnload);
 
