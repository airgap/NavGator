From b2df24e9c9154ee8916d31a1e98a1caeaf488b8b Mon Sep 17 00:00:00 2001
From: Nicole Muzzin <nicole@muzz.in>
Date: Sun, 4 Oct 2026 04:42:03 -0400
Subject: [PATCH] script: window.locationbar, menubar, personalbar, scrollbars,
 statusbar and toolbar

The BarProp attributes were commented out. weibo.com's bundle names a Vue
component from an undeclared `toolbar`, which browsers resolve to
window.toolbar; the ReferenceError kept the app from mounting and the page
stayed blank. Each attribute is its own BarProp, and visible is true since
no webview here is a popup with hidden bars.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 components/script/dom/barprop.rs              | 37 ++++++++++++++++
 components/script/dom/mod.rs                  |  1 +
 components/script/dom/window/window.rs        | 44 +++++++++++++++++++
 .../script_bindings/codegen/Bindings.conf     |  2 +-
 .../script_bindings/webidls/BarProp.webidl    |  9 ++++
 .../script_bindings/webidls/Window.webidl     | 12 ++---
 6 files changed, 98 insertions(+), 7 deletions(-)
 create mode 100644 components/script/dom/barprop.rs
 create mode 100644 components/script_bindings/webidls/BarProp.webidl

diff --git a/components/script/dom/barprop.rs b/components/script/dom/barprop.rs
new file mode 100644
index 00000000000..35f1b762302
--- /dev/null
+++ b/components/script/dom/barprop.rs
@@ -0,0 +1,37 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+use dom_struct::dom_struct;
+use script_bindings::reflector::{Reflector, reflect_dom_object};
+
+use crate::dom::bindings::codegen::Bindings::BarPropBinding::BarPropMethods;
+use crate::dom::bindings::root::DomRoot;
+use crate::dom::window::Window;
+use crate::script_runtime::CanGc;
+
+/// <https://html.spec.whatwg.org/multipage/#barprop>
+#[dom_struct]
+pub(crate) struct BarProp {
+    reflector_: Reflector,
+}
+
+impl BarProp {
+    pub(crate) fn new(window: &Window, can_gc: CanGc) -> DomRoot<BarProp> {
+        reflect_dom_object(
+            Box::new(BarProp {
+                reflector_: Reflector::new(),
+            }),
+            window,
+            can_gc,
+        )
+    }
+}
+
+impl BarPropMethods<crate::DomTypeHolder> for BarProp {
+    /// <https://html.spec.whatwg.org/multipage/#dom-barprop-visible>
+    fn Visible(&self) -> bool {
+        // Only popup windows report hidden bars, and every webview here is a full browser tab.
+        true
+    }
+}
