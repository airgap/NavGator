         CounterStyle::None | CounterStyle::String(_) => unreachable!("Invalid counter style"),
         CounterStyle::Name(name) => match name.0 {
@@ -129,7 +309,7 @@ pub(crate) fn generate_counter_representation(counter_style: &CounterStyle) -> &
